# ---- Supabase ----
# Leave all blank for local dev to render the bundled seed data with no DB.
NEXT_PUBLIC_SUPABASE_URL=
# REQUIRED for any real DB. RLS is locked (migration 0005); all reads/writes go
# through the server with this key. Keep it SECRET — server-only, never exposed.
SUPABASE_SERVICE_ROLE_KEY=
# Optional / unused by the app — the browser no longer talks to Supabase directly,
# and with RLS locked the anon key reads nothing. Safe to leave blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres/DB password — only for direct connections + the supabase CLI, not the app.
SUPABASE_DB_PASSWORD=

# ---- Password gate ----
# Both REQUIRED in production — the app fails closed (HTTP 503) without them.
# If either is blank the app runs ungated, but ONLY in local dev.
DASHBOARD_PASSWORD=     # use a strong, unique password
AUTH_SECRET=            # long random string, e.g. `openssl rand -hex 32`

# ---- Phase 2 (Telegram + Whisper + Claude) — not used yet ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_CHAT_ID=

# ---- Apple Health → /api/movement ingest ----
# Shared token an iPhone Shortcut sends as `x-ingest-secret`. Random string.
# REQUIRED in production — /api/movement returns 503 if this is unset in prod.
MOVEMENT_INGEST_SECRET=

# ---- Google Calendar (iCal) → events block ----
# One or more Google Calendar "Secret address in iCal format" URLs, comma-separated.
# Calendar settings → <your calendar> → "Secret address in iCal format".
GOOGLE_CALENDAR_ICS_URLS=

# ---- Gmail (IMAP, app password) → inbox block ----
# Requires 2FA on the Google account, then an App Password (Google Account →
# Security → App passwords). Use the 16-char app password, NOT your login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
